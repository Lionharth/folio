{
  "expo": {
    "name": "Folio",
    "slug": "folio",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "folio",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F7F4",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "life.folio.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Folio lets you import videos from your library into private circles.",
        "NSMicrophoneUsageDescription": "Folio records audio with the videos you capture.",
        "NSCameraUsageDescription": "Folio records videos and scans Folio IDs to share with your circles."
      }
    },
    "android": {
      "package": "life.folio.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F4",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111111",
            "image": "./assets/images/splash-wordmark-dark.png"
          },
          "android": {
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#171717",
          "defaultChannel": "moments",
          "enableRemoteNotifications": true
        }
      ],
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Folio records videos and scans Folio IDs to share with your circles.",
          "microphonePermission": "Folio records audio with the videos you capture.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Folio lets you import videos from your library into private circles."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "\n# Room creates generated database implementations by reflection.\n# WorkManager instantiates WorkDatabase_Impl this way during startup, so R8\n# must keep the no-argument constructor in minified release builds.\n-keep class * extends androidx.room.RoomDatabase {\n    <init>();\n}\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "60648524-595c-42f2-bdd1-b83d174072db"
      }
    },
    "owner": "theshadymooncat"
  }
}
